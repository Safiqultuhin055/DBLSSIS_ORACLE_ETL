    <DTS:Executable
      DTS:refId="Package\ORACLE_TARGET_ROW_COUNT"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Read-only: target row count and duplicate BATCHNO groups before load"
      DTS:DTSID="{4CC64A46-5D64-4F8E-8074-328952331A16}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ORACLE_TARGET_ROW_COUNT"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045001BE-1809-47F1-81D1-80CC395F6877}"
          SQLTask:SqlStatementSource="SELECT TO_CHAR(t.CNT) AS TARGET_ROWS, TO_CHAR(d.CNT) AS TARGET_DUP_KEYS&#xA;FROM (SELECT COUNT(*) AS CNT FROM APPS.ETL_BATCH_SQL_STG) t&#xA;CROSS JOIN (SELECT COUNT(*) AS CNT FROM (SELECT BATCHNO FROM APPS.ETL_BATCH_SQL_STG&#xA;            WHERE BATCHNO IS NOT NULL GROUP BY BATCHNO HAVING COUNT(*) &gt; 1)) d"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::TargetRowsBefore" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::TargetDupKeys" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ORACLE_TARGET_ROW_COUNT_POST"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Read-only: target row count after load"
      DTS:DTSID="{7A800117-43F2-4850-BE24-919968849289}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ORACLE_TARGET_ROW_COUNT_POST"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045001BE-1809-47F1-81D1-80CC395F6877}"
          SQLTask:SqlStatementSource="SELECT TO_CHAR(COUNT(*)) AS TARGET_ROWS FROM APPS.ETL_BATCH_SQL_STG"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::TargetRowsAfter" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_FAIL_POST_VALIDATION"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Raises an error (no data change) when reconciliation fails or rows were rejected"
      DTS:DTSID="{E786D598-A2F4-4BF0-A5EF-BF206309CE96}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_FAIL_POST_VALIDATION"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"RAISERROR(N'ETL post-validation failed. SourceRows=" + (DT_WSTR,12)@[User::SourceRows] + ", RcSource=" + (DT_WSTR,12)@[User::RcSource] + ", RcInvalidKey=" + (DT_WSTR,12)@[User::RcInvalidKey] + ", RcNew=" + (DT_WSTR,12)@[User::RcNew] + ", RcUnchanged=" + (DT_WSTR,12)@[User::RcUnchanged] + ", RcChanged=" + (DT_WSTR,12)@[User::RcChanged] + ", RcRejected=" + (DT_WSTR,12)@[User::RcRejected] + ", TargetRowsBefore=" + @[User::TargetRowsBefore] + ", TargetRowsAfter=" + @[User::TargetRowsAfter] + ". See CSV files in LogFolder.', 16, 1);"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DEA3E2C-2990-497F-96D4-E32EB23613EC}"
          SQLTask:SqlStatementSource="RAISERROR(N'ETL post-validation failed. SourceRows=0, RcSource=0, RcInvalidKey=0, RcNew=0, RcUnchanged=0, RcChanged=0, RcRejected=0, TargetRowsBefore=0, TargetRowsAfter=0. See CSV files in LogFolder.', 16, 1);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_FAIL_PRE_VALIDATION"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Raises an error (no data change) when duplicate keys exist; nothing is loaded"
      DTS:DTSID="{E4467378-F9B4-4DA7-8038-2D026A4F2984}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_FAIL_PRE_VALIDATION"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"RAISERROR(N'ETL pre-validation failed: duplicate BatchNO groups in source = " + (DT_WSTR,12)@[User::SourceDupKeys] + ", duplicate BATCHNO groups in Oracle target = " + @[User::TargetDupKeys] + ". No rows were loaded.', 16, 1);"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DEA3E2C-2990-497F-96D4-E32EB23613EC}"
          SQLTask:SqlStatementSource="RAISERROR(N'ETL pre-validation failed: duplicate BatchNO groups in source = 0, duplicate BATCHNO groups in Oracle target = 0. No rows were loaded.', 16, 1);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_SOURCE_ROW_COUNT"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Read-only: source row count, NULL/blank BatchNO count, duplicate BatchNO groups"
      DTS:DTSID="{288BB6DF-C567-4074-826A-F3E02EE593DE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_SOURCE_ROW_COUNT"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DEA3E2C-2990-497F-96D4-E32EB23613EC}"
          SQLTask:SqlStatementSource="SELECT COUNT(*) AS SOURCE_ROWS,&#xA;       ISNULL(SUM(CASE WHEN BatchNO IS NULL OR LTRIM(RTRIM(BatchNO)) = N'' THEN 1 ELSE 0 END), 0) AS SOURCE_INVALID_KEYS,&#xA;       (SELECT COUNT(*) FROM (SELECT BatchNO FROM dbo.ETL_Batch_SQL_STG&#xA;                              WHERE BatchNO IS NOT NULL AND LTRIM(RTRIM(BatchNO)) &lt;&gt; N''&#xA;                              GROUP BY BatchNO HAVING COUNT(*) &gt; 1) d) AS SOURCE_DUP_KEYS&#xA;FROM dbo.ETL_Batch_SQL_STG"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::SourceRows" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::SourceInvalidKeys" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="2"
            SQLTask:DtsVariableName="User::SourceDupKeys" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
